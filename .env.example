# livesim 실행에 필요한 환경변수. 복사해서 .env로 쓰세요 (.env는 커밋 금지).
#
# 0.2.0부터 관리자 계정이 필요 없습니다. 디바이스 자격증명은 devices.yaml에
# 넣습니다 (devices.example.yaml 참고).
#
# 컨테이너에서 호스트의 백엔드/브로커에 붙을 때는 localhost 대신
# host.docker.internal 을 쓰세요 (docker-compose.yml에 매핑되어 있습니다).

API_BASE_URL=
MQTT_HOST=
MQTT_PORT=

# 디바이스 크리덴셜 인벤토리 경로 (기본: devices.yaml)
DEVICES_FILE=

# livesim ctl 명령/상태 교환 디렉터리 (기본: control)
CONTROL_DIR=
